{
  "permissions": {
    "allow": [
      "bash:mvn",
      "bash:./mvnw",
      "bash:git",
      "bash:docker",
      "bash:docker-compose",
      "bash:find",
      "bash:grep",
      "bash:cat",
      "bash:ls"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/checkstyle_on_edit.py",
            "timeout": 120,
            "statusMessage": "Running checkstyle..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/git_commit_test_gate.py",
            "timeout": 300,
            "statusMessage": "Running mvn test before commit..."
          }
        ]
      }
    ]
  }
}
