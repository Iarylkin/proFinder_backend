# Copy to .env and fill in. .env is ignored by git and read by both
# Quarkus (dev mode) and docker compose.
DB_PASSWORD=change-me
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-min-8-chars
JWT_PRIVATE_KEY_PATH=keys/privateKey.pem
JWT_PUBLIC_KEY_PATH=keys/publicKey.pem
